PORT=8080


# Database configuration
DB_HOST=localhost
DB_PORT=5432

# DB_CONNECTION=file:ent?mode=memory&cache=shared&_fk=1
DB_CONNECTION=file:ent.db


# Headers configuration
ALLOWEDMETHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH 
ALLOWEDORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082
ALLOWEDHEADERS=Origin,Content-Type,Accept,X-Csrf-Token,X-Requested-With,Authorization
ALLOWEDCREDENTIALS=true
MAXAGE=3600


# JWT configuration
JWT_SECRET_ACCESS=your_jwt_secret_key_access
JWT_SECRET_REFRESH=your_jwt_secret_key_refresh

